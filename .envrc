#!/bin/bash
# Local fallback env vars (dev defaults only). Real secrets come from Infisical
# via the Java SDK at app startup; this .env is used only if Infisical is unavailable
# or no bootstrap credentials are configured.
if [ ! -f .env ]; then
  cp .env.example .env
  echo "direnv: .env not found — created from .env.example"
fi
dotenv_if_exists

# Non-secret, machine-local config — needs ${PWD} shell expansion, not in Infisical
export JAVA_TOOL_OPTIONS="-javaagent:${PWD}/opentelemetry-javaagent.jar"
